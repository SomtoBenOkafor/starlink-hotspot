# ─────────────────────────────────────────
# Starlink Hotspot — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Paystack secret key (from your Paystack dashboard)
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_SECRET_KEY

# JWT secret — use a long random string
JWT_SECRET=replace_with_a_long_random_secret_string_here

# Network interface connected to your client WiFi devices
# Run `ip link show` to find yours (common: wlan0, eth1, br-lan)
HOTSPOT_INTERFACE=wlan0

# Port for the portal server
PORT=3000

# Node environment
NODE_ENV=production
